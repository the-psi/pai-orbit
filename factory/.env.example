# Credentials for the Agentic Factory. Copy to .env and fill in. Never commit .env.

# --- Model access (given to the agent) -------------------------------------------------
# Use an API key for a shared or customer factory.
ANTHROPIC_API_KEY=
# A personal subscription token (from `claude setup-token`) is acceptable only for a
# one-person trial on your own account.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Board and code host (held by the orchestrator, never given to the agent) ----------
# A token for the factory's own bot account, with access to issues and pull requests.
GH_TOKEN=

# --- Chat alerts (held by the orchestrator) ---------------------------------------------
FACTORY_SLACK_WEBHOOK_URL=

# --- Release credentials -----------------------------------------------------------------
# Name them in release.envPassthrough in the config. They reach only the release stage, and
# only after a named release approver approves. Leave empty at release level "tag".
